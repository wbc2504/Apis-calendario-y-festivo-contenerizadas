{
  "family": "api-calendariolaboral-task-definition",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::697568497647:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "api-calendario-laboral",
      "image": "697568497647.dkr.ecr.us-east-2.amazonaws.com/calendario-laboral-repo:latest",
      "cpu": 512,
      "memory": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://calendario-laboral-db.cx4cy4u4460o.us-east-2.rds.amazonaws.com:5432/calendariolaboral"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "Cripto-2026"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/calendario-laboral",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "spring"
        }
      }
    }
  ]
}